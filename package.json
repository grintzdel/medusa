{
  "name": "medusa",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "typecheck": "turbo typecheck",
    "test:e2e": "./scripts/e2e.sh"
  },
  "pnpm": {
    "overrides": {
      "tsconfig-paths": "^4.2.0",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "lodash": "^4.18.1",
      "@grpc/grpc-js": "^1.14.5",
      "brace-expansion@<2": "^1.1.20",
      "brace-expansion@>=4 <6": "^5.0.12",
      "postcss@>=8 <9": "^8.5.29",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5",
      "@graphql-tools/utils@12": "^12.0.3"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
